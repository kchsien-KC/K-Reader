<?xml version="1.0" encoding="utf-8"?>
<!--
  ═══════════════════════════════════════════════════════════════
   K.閱讀 v1.2 — 剪貼簿書源偵測提示條（主頁面底部）
  ═══════════════════════════════════════════════════════════════
   整合方式：於 activity_main.xml 的根容器（FrameLayout 系）內
   include 本布局，並由 ClipboardSourceDetector.bindClipboardBar()
   依偵測結果動態顯示／隱藏（預設 gone，無偵測時零干擾）。

   節點職責：
    · tv_clipboard_hint    偵測結果文案（偵測到剪貼簿中有書源設定）
    · tv_clipboard_import  一鍵匯入（實心主色鈕）
    · tv_clipboard_ignore  忽略本次（外框風格鈕）

   設計紀律：
    · 純主題屬性著色（colorSurface / colorPrimary），日夜間自動適配
    · 零點陣圖、零額外 drawable 檔案（< 15MB 體積紀律）
    · RTL 友善（paddingStart/End + marginStart/End）
    · 與 view_trial_bar.xml 同款視覺語言（懸浮條家族）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clipboard_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/colorSurface"
    android:elevation="8dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:visibility="gone">

    <!-- 左：偵測結果文案 -->
    <TextView
        android:id="@+id/tv_clipboard_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/clipboard_detected"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 中：忽略本次（外框風格，無框線漣漪） -->
    <TextView
        android:id="@+id/tv_clipboard_ignore"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="?attr/selectableItemBackground"
        android:text="@string/clipboard_ignore"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp"
        android:clickable="true"
        android:focusable="true" />

    <!-- 右：一鍵匯入（實心主色鈕） -->
    <TextView
        android:id="@+id/tv_clipboard_import"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="10dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/colorPrimary"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/clipboard_import_now"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
