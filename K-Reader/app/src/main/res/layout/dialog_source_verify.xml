<?xml version="1.0" encoding="utf-8"?>
<!--
  ═══════════════════════════════════════════════════════════════
   K.閱讀 v1.2 — 一鍵併發檢核進度對話框（書源管理頁）
  ═══════════════════════════════════════════════════════════════
   整合方式：BookSourceHealthManager.startVerifyAll() 內由
   VerifyProgressDialog 以 layoutInflater 動態注入（AlertDialog
   setView），不預先掛載於任何 Activity 布局。

   節點職責：
    · progress_verify    水平進度條（max = 來源總數）
    · tv_verify_progress 狀態列（檢核中 → 檢核完成：有效 X、失效 Y）
    · tv_verify_detail   明細列（當前來源名稱 · 步驟標籤）

   設計紀律：
    · 純主題屬性著色（textColorPrimary / Secondary），日夜間自動適配
    · 零點陣圖、零額外 drawable（< 15MB 體積紀律）
    · RTL 友善（僅用對稱 padding）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/verify_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <!-- 水平進度條：完成數 / 來源總數 -->
    <ProgressBar
        android:id="@+id/progress_verify"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="false"
        android:max="100"
        android:progress="0" />

    <!-- 狀態列：併發檢核中… → 檢核完成：有效 X、失效 Y -->
    <TextView
        android:id="@+id/tv_verify_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/verify_running"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="15sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 明細列：當前來源名稱 · 步驟（關鍵字搜尋 / 取得目錄 / 抓取首章正文） -->
    <TextView
        android:id="@+id/tv_verify_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
