<?xml version="1.0" encoding="utf-8"?>
<!--
  ═══════════════════════════════════════════════════════════════
   K.閱讀 v1.2 — 閱讀年報對話框（Stage 13）
  ═══════════════════════════════════════════════════════════════
   整合方式：設定頁「閱讀年報」→ 載入本對話框 →
   ReadingAnnualReportHelper.buildReport() 聚合六方數據 →
   buildCard() 組 36 顯示寬度純文字卡餵 tv_annual_card；
   分享鈕主路複製剪貼簿（copiedNotice）、輔路 ACTION_SEND。

   節點職責：
    · tv_annual_summary 標題行（annual_title，粗體強調）
    · tv_annual_card    年報卡本文（等寬字體對齊框線；
                        ScrollView 包裹——長卡不撐爆對話框）
    · tv_annual_empty   空狀態提示（無記錄時顯示）
    · btn_annual_share  分享鈕（外框風格——主路剪貼簿）
    · btn_annual_close  關閉鈕（外框風格鈕）

   設計紀律：
    · 純主題屬性著色（colorPrimary／textColorSecondary），
      日夜間自動適配
    · 零點陣圖、零額外 drawable 檔案（體積紀律）
    · RTL 友善（paddingStart/End）
    · 與 dialog_badges／dialog_queue 同款視覺語言
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 標題行：閱讀年報 -->
    <TextView
        android:id="@+id/tv_annual_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:text="@string/annual_title"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 空狀態提示 -->
    <TextView
        android:id="@+id/tv_annual_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:text="@string/annual_empty"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 年報卡本文（等寬字體——框線與全形對齊；可選取複製） -->
    <ScrollView
        android:id="@+id/sv_annual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <TextView
            android:id="@+id/tv_annual_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:minHeight="240dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </ScrollView>

    <!-- 分享鈕（外框風格——剪貼簿主路） -->
    <Button
        android:id="@+id/btn_annual_share"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/annual_share" />

    <!-- 關閉鈕（外框風格鈕） -->
    <Button
        android:id="@+id/btn_annual_close"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="@string/annual_close" />

</LinearLayout>
