<?xml version="1.0" encoding="utf-8"?>
<!--
  ═══════════════════════════════════════════════════════════════
   K.閱讀 v1.2 — 字體管理對話框（Stage 9）
  ═══════════════════════════════════════════════════════════════
   整合方式：設定「字體管理」→ 載入本對話框 →
   CustomFontManager.list() 餌列表；「匯入字體」走 SAF
   ACTION_OPEN_DOCUMENT 挑選 TTF／OTF → importFont()。

   節點職責：
    · tv_font_hint    頂部說明（支援格式與單檔上限）
    · tv_font_empty   空狀態提示（無字體時顯示）
    · rv_font_list    字體清單（名稱＋體積＋套用／刪除；
                      列布局由適配器以程式碼組建——零額外
                      item 檔案，體積紀律）
    · btn_font_import 匯入字體（實心主色鈕）
    · btn_font_revert 還原預設字體（外框風格鈕）

   設計紀律：
    · 純主題屬性著色（colorPrimary／colorOnPrimary／
      textColorSecondary），日夜間自動適配
    · 零點陣圖、零額外 drawable 檔案（體積紀律）
    · RTL 友善（marginStart/End＋paddingStart/End）
    · 與 dialog_note_editor／dialog_bookmark_list 同款視覺語言
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 頂部說明（支援格式與單檔上限） -->
    <TextView
        android:id="@+id/tv_font_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/font_hint"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <!-- 空狀態提示（有字體時由程式碼隱藏） -->
    <TextView
        android:id="@+id/tv_font_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="96dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:text="@string/font_empty_hint"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp" />

    <!-- 字體清單（捲動容器包覆——滿倉 20 款不撐爆對話框） -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp"
        android:scrollbars="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_font_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />
    </ScrollView>

    <!-- 動作列：匯入字體（實心）＋還原預設（外框） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_font_import"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?attr/colorPrimary"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/font_import"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_font_revert"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/font_revert"
            android:textColor="?attr/textColorSecondary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
