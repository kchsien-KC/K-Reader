<?xml version="1.0" encoding="utf-8"?>
<!--
  ═══════════════════════════════════════════════════════════════
   K.閱讀 v1.2 — 字詞快查對話框
  ═══════════════════════════════════════════════════════════════
   整合方式：閱讀頁長按選詞 → DictLookupHelper.lookup(word) →
   formatResult 後 showDialog——三源（內建成語典／教育部辭典／
   維基百科）分區呈現，查詢中狀態列、一鍵複製釋義。

   節點職責：
    · tv_dict_word      查詢詞（大字標題）
    · row_dict_status   查詢中狀態列（ProgressBar＋文案，gone）
    · sv_dict_result    結果捲動容器（長釋義不撐爆對話框）
    · tv_dict_result    結果文字（三源分區——標題行＋釋義）
    · btn_dict_copy     一鍵複製釋義（copied 回饋）

   設計紀律：
    · 純主題屬性著色（colorPrimary／colorOnPrimary／
      textColorSecondary），日夜間自動適配
    · 零點陣圖、零額外 drawable 檔案（體積紀律）
    · RTL 友善（marginStart/End＋paddingStart/End）
    · 與 dialog_ai_assistant.xml 同款視覺語言（對話框家族）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 查詢詞（大字標題） -->
    <TextView
        android:id="@+id/tv_dict_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:textColor="?attr/colorPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 查詢中狀態列（預設 gone——結果回填時隱藏） -->
    <LinearLayout
        android:id="@+id/row_dict_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dict_searching"
            android:textColor="?attr/textColorSecondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 結果捲動容器（長釋義不撐爆） -->
    <ScrollView
        android:id="@+id/sv_dict_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="320dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tv_dict_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.5"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp" />
    </ScrollView>

    <!-- 動作列：一鍵複製釋義（外框風格鈕） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_dict_copy"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="?attr/colorPrimary"
            android:foreground="?attr/selectableItemBackground"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/dict_copy_definition"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
