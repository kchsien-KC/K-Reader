<?xml version="1.0" encoding="utf-8"?>
<!--
  ═══════════════════════════════════════════════════════════════
   K.閱讀 v1.2 — 隱私鎖 PIN 解鎖對話框
  ═══════════════════════════════════════════════════════════════
   整合方式：PrivacyLockManager.showUnlockPinDialog(activity)——
   生物辨識不可用／被取消／驗證失敗時的 PIN 備援輸入。

   節點職責：
    · til_privacy_pin    PIN 輸入容器（Material TextInputLayout）
    · et_privacy_pin     PIN 輸入欄（數字鍵盤、密碼遮罩、4–6 位）
    · row_privacy_hint   解鎖說明列（privacy_lock_pin_hint 文案）

   設計紀律：
    · 純主題屬性著色（colorPrimary／textColorSecondary），
      日夜間自動適配
    · 零點陣圖、零額外 drawable 檔案（體積紀律）
    · RTL 友善（marginStart/End＋paddingStart/End）
    · 對話框不可逃逸（setOnCancelListener 重開——鎖就是鎖）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <!-- 解鎖說明列 -->
    <TextView
        android:id="@+id/row_privacy_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="start"
        android:text="@string/privacy_lock_pin_hint"
        android:textColor="?attr/textColorSecondary"
        android:textSize="13sp" />

    <!-- PIN 輸入容器（錯誤提示空間由 TextInputLayout 自帶） -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_privacy_pin"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/privacy_lock_pin_hint"
        app:boxCornerRadiusTopStart="10dp"
        app:boxCornerRadiusTopEnd="10dp"
        app:boxCornerRadiusBottomStart="10dp"
        app:boxCornerRadiusBottomEnd="10dp"
        app:counterEnabled="true"
        app:counterMaxLength="6"
        app:startIconContentDescription="@string/privacy_lock">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_privacy_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:maxLines="1"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
