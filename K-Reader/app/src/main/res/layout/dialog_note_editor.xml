<?xml version="1.0" encoding="utf-8"?>
<!--
  ═══════════════════════════════════════════════════════════════
   K.閱讀 v1.2 — 劃線筆記編輯對話框（Stage 8）
  ═══════════════════════════════════════════════════════════════
   整合方式：閱讀頁長按選取 → 選取氣泡「筆記」→ 載入本對話框
   （劃線內容預填）→ HighlightNoteManager.saveHighlight()——
   批註＋三色分類一次到位。

   節點職責：
    · sv_note_quote       劃線內容捲動容器（長劃線不撐爆）
    · tv_note_quote       劃線內容（引文風格呈現）
    · til_note_content    批註輸入容器（Material OutlinedBox）
    · et_note_content     批註輸入欄（多行、隨想隨寫）
    · rg_note_colors      三色分類單選群組（金句黃／疑問藍／重點紅）
    · btn_note_save       儲存筆記（實心主色鈕）
    · btn_note_to_quote   生成金句卡（外框風格鈕——委託
                           GoldenQuoteManager 裱卡）

   設計紀律：
    · 純主題屬性著色（colorPrimary／colorOnPrimary／
      textColorSecondary），日夜間自動適配
    · 零點陣圖、零額外 drawable 檔案（體積紀律）
    · RTL 友善（marginStart/End＋paddingStart/End）
    · 與 dialog_ai_assistant／dialog_dict_lookup 同款視覺語言
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 劃線內容（引文風格） -->
    <ScrollView
        android:id="@+id/sv_note_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="180dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tv_note_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.5"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="italic" />
    </ScrollView>

    <!-- 批註輸入容器 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_note_content"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/note_edit_hint"
        app:boxCornerRadiusTopStart="10dp"
        app:boxCornerRadiusTopEnd="10dp"
        app:boxCornerRadiusBottomStart="10dp"
        app:boxCornerRadiusBottomEnd="10dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_note_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|top"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 三色分類單選群組 -->
    <RadioGroup
        android:id="@+id/rg_note_colors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="40dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_note_quote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:minHeight="40dp"
            android:text="@string/note_color_quote"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_note_question"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="@string/note_color_question"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_note_key"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="@string/note_color_key"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- 動作列：儲存筆記（實心）＋生成金句卡（外框） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_note_save"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?attr/colorPrimary"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/note_save"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_note_to_quote"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/note_to_quote"
            android:textColor="?attr/textColorSecondary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
